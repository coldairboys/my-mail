{
  "name": "my-mail",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint \"assets/js/**/*.js\"",
    "format": "prettier --write \"assets/**/*.{js,css,html}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"assets/**/*.{js,css,html}\" \"*.{js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "assets/js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "assets/**/*.{css,html}": [
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "husky": "^9.1.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
